{
  "expo": {
    "name": "겹날",
    "slug": "still-me",
    "scheme": "stillme",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "com.stillme.diary" },
    "android": {
      "package": "com.stillme.diary",
      "allowBackup": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 첨부할 사진을 선택하려면 사진 보관함을 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-diary-backup-exclusion"
    ]
  }
}
